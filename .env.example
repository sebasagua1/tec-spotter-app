# Supabase — find these in your Supabase project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Mapbox — https://account.mapbox.com/access-tokens
# Also set MAPBOX_TOKEN as a secret in Supabase Edge Functions for the get-mapbox-token function
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Restringe el registro a los dominios de la lista de restrict-tec-email-domain.sql
# (hoy @tec.mx/@exatec.mx/@itesm.mx). Apagado por defecto. Pon "true" solo cuando
# quieras cerrar el registro, y aplica también esa migración.
# NOMBRE HEREDADO: la lista de dominios pasa a la tabla de instituciones (Fase 3).
VITE_RESTRICT_TEC_EMAIL=false

# Google Sign-In NATIVO en iOS (Capacitor). Crea dos OAuth Client IDs en
# Google Cloud: uno tipo "iOS" y uno tipo "Web". El botón de Google en la
# app iOS solo aparece si AMBOS están puestos. (Apple no necesita config aquí.)
# Ver APP_STORE.md → "Social login".
VITE_GOOGLE_IOS_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# --- Solo para los tests de RLS (opcional) ---
# Apuntan a un proyecto Supabase APARTE: la suite crea y borra usuarios,
# eventos y grupos. Si no se definen, esos 30 tests se omiten y vitest lo
# dice; nunca deben apuntar al proyecto de producción de arriba.
VITE_TEST_SUPABASE_URL=
VITE_TEST_SUPABASE_ANON_KEY=
